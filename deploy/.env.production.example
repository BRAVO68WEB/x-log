# x-log Production Environment Configuration
# Copy this file to .env.production and fill in your values.

# ── Required ────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase, Neon, or self-hosted)
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Session secret (min 32 chars, generate with: openssl rand -base64 32)
SESSION_SECRET=

# Your instance domain (no protocol, e.g. myblog.example.com)
INSTANCE_DOMAIN=

# ── OIDC (Required for auth) ───────────────────────────────────────

OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://YOUR_DOMAIN/auth/oidc/callback
OIDC_DISCOVERY_URL=https://YOUR_ISSUER/.well-known/openid-configuration

# ── Internal API URL ────────────────────────────────────────────────

# URL where the Hono API server is reachable from Next.js
# If deploying API separately: use the internal URL
# If using Vercel: point to your Railway/Render API URL
BACKEND_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Redis (for federation delivery queue) ───────────────────────────

REDIS_URL=redis://localhost:6379

# ── Optional ────────────────────────────────────────────────────────

# Instance display name
INSTANCE_NAME=x-log

# Admin contact email (used in email from address)
ADMIN_EMAIL=

# SMTP URL for password reset emails (e.g. smtps://user:pass@smtp.gmail.com:465)
SMTP_URL=

# Federation (default: true)
FEDERATION_ENABLED=true

# Open registrations (default: false)
OPEN_REGISTRATIONS=false

# API server port (default: 8080)
PORT=8080

# ── Feature Flags (ENV override, takes precedence over DB) ─────────
# FEATURE_CODE_SNIPPETS=false
# FEATURE_LINK_ARCHIVE=false
# FEATURE_AI_WRITER=false
# FEATURE_PASSWORD_RESET=false
# FEATURE_CUSTOM_POST_META=false
# FEATURE_BOOKMARKS=false
# FEATURE_REPOSTS=false
# FEATURE_THREADS=false
# FEATURE_SHORT_POSTS=false
# FEATURE_SCHEDULED_POSTS=false
# FEATURE_TRENDING=false
# FEATURE_ANALYTICS=false
# FEATURE_DMS=false
# FEATURE_CUSTOM_THEMES=false

# ── AI Writer (OpenAI-compatible API) ──────────────────────────────
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_TOKENS=2048
# OPENAI_TEMPERATURE=0.7
