{
  "name": "xLog Deploy to Vercel",
  "description": "Deploy xLog to Vercel with one click",
  "砂盒": "vercel",
  "template": {
    "repoUrl": "https://github.com/CaiJimmy/xLog",
    "ref": "main",
    "files": [
      {
        "src": "vercel.json",
        "dest": "vercel.json"
      },
      {
        "src": "env.example",
        "dest": ".env"
      }
    ]
  },
  "env": [
    {
      "name": "DATABASE_URL",
      "description": "PostgreSQL connection string",
      "type": "string",
      "required": true
    },
    {
      "name": "NEXTAUTH_SECRET",
      "description": "Secret for session encryption",
      "type": "string",
      "required": true,
      "generator": "secret"
    },
    {
      "name": "NEXTAUTH_URL",
      "description": "Your deployment URL (e.g., https://your-app.vercel.app)",
      "type": "string",
      "required": true,
      "value": "{{ALIAS_URL}}"
    },
    {
      "name": "RESEND_API_KEY",
      "description": "API key for sending emails (optional)",
      "type": "string",
      "required": false
    },
    {
      "name": "SMTP_HOST",
      "description": "SMTP server host (optional)",
      "type": "string",
      "required": false
    },
    {
      "name": "SMTP_PORT",
      "description": "SMTP server port (optional)",
      "type": "string",
      "required": false
    },
    {
      "name": "SMTP_USER",
      "description": "SMTP username (optional)",
      "type": "string",
      "required": false
    },
    {
      "name": "SMTP_PASSWORD",
      "description": "SMTP password (optional)",
      "type": "string",
      "required": false
    },
    {
      "name": "SMTP_FROM",
      "description": "From email address (optional)",
      "type": "string",
      "required": false
    },
    {
      "name": "OPENAI_API_KEY",
      "description": "OpenAI API key for AI features (optional)",
      "type": "string",
      "required": false
    },
    {
      "name": "OPENAI_BASE_URL",
      "description": "OpenAI-compatible API base URL (optional, for self-hosted models)",
      "type": "string",
      "required": false
    }
  ],
  "buildCommand": "bun run build",
  "envVarsHint": "Set the required environment variables to deploy."
}
