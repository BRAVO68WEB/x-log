# x-log Environment Configuration
# Copy this file to .env and adjust values for your local development environment

# Node Environment
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgres://xlog:xlogpass@localhost:5432/xlog

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Instance Configuration
INSTANCE_DOMAIN=localhost
INSTANCE_NAME=x-log
ADMIN_EMAIL=admin@example.com
OPEN_REGISTRATIONS=false

# SMTP Configuration (optional)
SMTP_URL=

# Session Secret (generate a random string at least 32 characters long)
# For production, use: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-random-secret-at-least-32-characters-long-for-production

# MCP server (Model Context Protocol) — remote tools for Cursor / Claude
# Generate: openssl rand -hex 32
# In production, MCP is disabled unless MCP_API_KEY is set.
MCP_API_KEY=
# Optional: force on/off ("true" | "false"). Unset = auto (key present).
# MCP_ENABLED=true
# Local user write tools act as (defaults to primary admin):
# MCP_ACTOR_USERNAME=admin

# Federation
FEDERATION_ENABLED=true

# API Port
PORT=8080

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Feature Flags (optional)
# ENV overrides take precedence over admin UI settings.
# Set to "true" or "false" to force a feature on/off.
# FEATURE_CODE_SNIPPETS=false
# FEATURE_LINK_ARCHIVE=false
# FEATURE_AI_WRITER=false
# FEATURE_PASSWORD_RESET=false
# FEATURE_CUSTOM_POST_META=false
# FEATURE_BOOKMARKS=false
# FEATURE_REPOSTS=false
# FEATURE_THREADS=false
# FEATURE_SHORT_POSTS=false
# FEATURE_SCHEDULED_POSTS=false
# FEATURE_TRENDING=false
# FEATURE_ANALYTICS=false
# FEATURE_DMS=false
# FEATURE_CUSTOM_THEMES=false

# AI Writer (optional, OpenAI-compatible API)
# Works with OpenAI, Ollama, Groq, Fireworks, Together, or any compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_TOKENS=2048
# OPENAI_TEMPERATURE=0.7
