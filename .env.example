# x-log Environment Configuration
# Copy this file to .env and adjust values for your local development environment

# Node Environment
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgres://xlog:xlogpass@localhost:5432/xlog

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Instance Configuration
INSTANCE_DOMAIN=localhost
INSTANCE_NAME=x-log
ADMIN_EMAIL=admin@example.com
OPEN_REGISTRATIONS=false

# SMTP Configuration (optional)
SMTP_URL=

# Session Secret (generate a random string at least 32 characters long)
# For production, use: openssl rand -base64 32
# This is not an MCP credential and is not a substitute for DATA_ENCRYPTION_KEY.
SESSION_SECRET=change-this-to-a-random-secret-at-least-32-characters-long-for-production

# 32-byte AES-256-GCM key, standard base64. Required when NODE_ENV=production.
# openssl rand -base64 32
# Encrypts ActivityPub private keys and Nostr secrets. Do not derive it from SESSION_SECRET.
DATA_ENCRYPTION_KEY=

# Allow an AI base URL that resolves to a private or loopback address.
# Leave unset in production unless you intentionally call a local model.
# AI_ALLOW_PRIVATE_BASE=false

# Trusted reverse proxies in front of the API. 0 uses the socket address only.
# Set to 1 behind a single nginx or Cloudflare proxy. That proxy must strip
# client-supplied CF-Connecting-IP and X-Forwarded-For before appending its own.
# TRUSTED_PROXY_HOPS=0

# MCP server (Model Context Protocol) — remote tools for Cursor / Claude
# Generate: openssl rand -hex 32
# Instance key is optional. Per-user keys still work. Query ?api_key= is not accepted.
# SESSION_SECRET is never accepted as an MCP key.
MCP_API_KEY=
# Optional: force on/off ("true" | "false"). Unset = auto (key present).
# MCP_ENABLED=true
# Local user write tools act as (defaults to primary admin):
# MCP_ACTOR_USERNAME=admin

# Federation
FEDERATION_ENABLED=true

# First-party analytics (also requires admin feature flag "analytics" ON)
# ANALYTICS_SALT=optional-hmac-salt-defaults-to-session-secret
# ANALYTICS_STORE_RAW_IP=false
# ANALYTICS_RESPECT_DNT=true
# ANALYTICS_RETENTION_DAYS=90

# OpenTelemetry (opt-in)
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=x-log-api

# PostHog (opt-in product analytics — use your own project)
# POSTHOG_ENABLED=false
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_SERVER_ENABLED=false
# For Next.js client (apps/web):
# NEXT_PUBLIC_POSTHOG_ENABLED=true
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# API Port
PORT=8080

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Feature Flags (optional)
# ENV overrides take precedence over admin UI settings.
# Set to "true" or "false" to force a feature on/off.
# FEATURE_CODE_SNIPPETS=false
# FEATURE_LINK_ARCHIVE=false
# FEATURE_AI_WRITER=false
# FEATURE_PASSWORD_RESET=false
# FEATURE_CUSTOM_POST_META=false
# FEATURE_BOOKMARKS=false
# FEATURE_REPOSTS=false
# FEATURE_THREADS=false
# FEATURE_SHORT_POSTS=false
# FEATURE_SCHEDULED_POSTS=false
# FEATURE_TRENDING=false
# FEATURE_ANALYTICS=false
# FEATURE_DMS=false
# FEATURE_CUSTOM_THEMES=false

# AI Writer (optional, OpenAI-compatible API)
# Works with OpenAI, Ollama, Groq, Fireworks, Together, or any compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_TOKENS=2048
# OPENAI_TEMPERATURE=0.7
