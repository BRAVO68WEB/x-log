{
  "name": "x-log",
  "version": "1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv run -- turbo run dev",
    "mobile": "bun run --cwd apps/mobile dev",
    "mobile:ios": "bun run --cwd apps/mobile ios",
    "mobile:android": "bun run --cwd apps/mobile android",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,js,jsx}\"",
    "validate:themes": "bun run scripts/validate-themes.ts",
    "type-check": "turbo run type-check",
    "test": "bun run --cwd packages/ap test && bun run --cwd packages/db test && bun run --cwd apps/api test",
    "test:smoke": "bash ./scripts/smoke-api.sh",
    "test:e2e-auth": "bash ./scripts/smoke-e2e-auth.sh",
    "test:integration": "bun run --cwd apps/api test src/app.integration.test.ts",
    "migrate": "dotenv run -- turbo run migrate",
    "start": "dotenv run -- turbo run start"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.0.0",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "dotenv": "^18.0.9",
    "next": "^16.4.3"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dompurify": "3.4.17",
    "qs": "6.16.1",
    "fast-uri": "3.1.9",
    "path-to-regexp": "8.4.2",
    "@xmldom/xmldom": "0.8.15",
    "postcss": "8.5.31",
    "hono": "4.13.13",
    "prosemirror-view": "1.42.8",
    "express-rate-limit": "8.2.2",
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.4",
    "lodash-es": "4.18.1",
    "markdown-it": "14.3.3",
    "linkify-it": "5.0.2",
    "tar": "7.5.22",
    "compression": "1.8.2",
    "body-parser": "2.4.0",
    "uuid": "11.1.1",
    "flatted": "3.4.4",
    "browserslist": "4.29.4",
    "mdast-util-to-hast": "13.2.1",
    "shell-quote": "1.12.0",
    "js-yaml": "4.3.2",
    "@humanfs/node": "0.16.8",
    "yaml": "2.9.1",
    "baseline-browser-mapping": "2.11.32",
    "@babel/core": "7.29.7",
    "@hono/node-server": "2.1.5",
    "postcss-selector-parser": "7.1.7",
    "image-size": "2.0.4",
    "decode-uri-component": "0.5.1"
  }
}
