{
  "name": "@xlog/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "migrate": "bun run ../../packages/db/src/migrate.ts",
    "init-local-user": "bun run scripts/init-local-user.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test src",
    "build": "bun build src/index.ts --outdir dist --target bun"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@hono/node-server": "^2.1.5",
    "@hono/standard-validator": "^0.4.0",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@scalar/hono-api-reference": "^0.12.14",
    "@xlog/ap": "workspace:*",
    "@xlog/config": "workspace:*",
    "@xlog/db": "workspace:*",
    "@xlog/libs": "workspace:*",
    "@xlog/markdown": "workspace:*",
    "@xlog/snowflake": "workspace:*",
    "@xlog/types": "workspace:*",
    "@xlog/validation": "workspace:*",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.13",
    "hono-openapi": "^1.5.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.7",
    "nodemailer": "^10.2.1",
    "openai": "^7.43.0",
    "posthog-node": "^5.57.1",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  }
}
